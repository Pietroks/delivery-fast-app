{
  "expo": {
    "name": "Delivery Fast",
    "slug": "delivery-fast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O aplicativo precisa da sua localização para organizar as entregas na sequência mais curta a partir de onde você está."
      }
    },
    "android": {
      "package": "com.pietroks.deliveryfast",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1320"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O aplicativo precisa da sua localização para organizar as entregas na sequência mais curta."
        }
      ],
      "expo-status-bar"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "828f4588-e2a1-4b09-ac63-37c364366029"
      }
    }
  }
}
